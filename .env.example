# This landing page runs with zero environment variables — everything below
# is a placeholder for later waves (see PRD.md) once auth/DB/AI are added.
# Never commit a real .env file. Anything without NEXT_PUBLIC_ is server-only
# and must never be read from client components.

# --- Supabase (Wave 2: Auth, Wave 3: Household) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server-only. Never expose to the client.

# --- AI Game Master "Q" (Wave 10) ---
AI_PROVIDER=
AI_PROVIDER_API_KEY=                  # server-only.
AI_PROMPT_VERSION=v1

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
