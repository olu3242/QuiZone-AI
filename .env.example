# Supabase publishable key only. Never put a service-role key in NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical origin used for email redirects (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Used by operational tools only; do not commit credentials.
SUPABASE_DB_URL=
# Q authoring suggestions (QZ-34). SERVER-ONLY: never prefix with NEXT_PUBLIC_.
# Also requires the operator flag: update private.feature_flags set enabled=true where flag='q_live';
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5-5).
QZ_Q_MODEL=
