{
  "name": "quizone",
  "version": "0.1.0",
  "private": true,
  "description": "QuiZone guardian-led family learning application",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:db": "node --import tsx --test tests/database.test.ts",
    "prebuild": "node scripts/generate-brand.mjs",
    "predev": "node scripts/generate-brand.mjs",
    "audit": "npm audit --audit-level=low",
    "test:e2e": "node --import tsx --test --test-concurrency=1 e2e/*.e2e.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.59.0",
    "next": "16.4.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.14.15",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "axe-core": "4.10.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "fast-glob": "file:tools/next-lint-glob",
    "minimatch": "file:tools/minimatch-compat",
    "playwright": "1.63.0",
    "postcss": "8.5.28",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.5.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@next/eslint-plugin-next@16.4.3": {
      "fast-glob": "$fast-glob"
    },
    "minimatch": "$minimatch"
  }
}
